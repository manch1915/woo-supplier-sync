msgstr "Сопоставьте названия поставщика с атрибутами магазина, например «Расцветка» с «Цвет». Оставьте правую часть пустой, чтобы не импортировать атрибут."

msgid "Supplier attribute"
msgstr "Атрибут поставщика"

msgid "Store attribute"
msgstr "Атрибут магазина"

msgid "Import attributes that are not in the list"
msgstr "Импортировать атрибуты, которых нет в списке"

msgid "Category mapping"
msgstr "Сопоставление категорий"

