{
  "name": "woo-supplier-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Admin app and storefront blocks for Supplier Sync for WooCommerce.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "npm run build:admin && npm run build:blocks",
    "build:admin": "wp-scripts build admin=./assets/src/admin/index.tsx --output-path=assets/build/admin",
    "build:blocks": "wp-scripts build --experimental-modules --webpack-src-dir=assets/src/blocks --output-path=assets/build/blocks",
    "start:admin": "wp-scripts start admin=./assets/src/admin/index.tsx --output-path=assets/build/admin",
    "lint:js": "wp-scripts lint-js assets/src",
    "lint:css": "wp-scripts lint-style \"assets/src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "test:js": "wp-scripts test-unit-js --passWithNoTests assets/src",
    "make-pot": "wp i18n make-pot . languages/woo-supplier-sync.pot --exclude=node_modules,vendor,tests,assets/src"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/icons": "^18.0.0",
    "@wordpress/interactivity": "^7.0.0",
    "@wordpress/scripts": "^36.1.0",
    "@wordpress/url": "^4.57.0",
    "typescript": "^5.9.3"
  }
}
