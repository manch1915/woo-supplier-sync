<?xml version="1.0"?>
<ruleset name="Supplier Sync">
	<description>WordPress coding standards with PSR-4 file names.</description>

	<file>./woo-supplier-sync.php</file>
	<file>./uninstall.php</file>
	<file>./src</file>
	<file>./tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/.wp-tests/*</exclude-pattern>
	<exclude-pattern>*/tests/fixtures/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress-Core">
		<!-- PSR-4 autoloading instead of class-*.php file names. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>
	<rule ref="WordPress-Extra"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woo-supplier-sync"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="supplier_sync"/>
				<element value="SupplierSync"/>
			</property>
		</properties>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Domain and feed parsing are plain PHP with no WordPress dependency, same as unit tests. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
		<exclude-pattern>*/src/Domain/*</exclude-pattern>
		<exclude-pattern>*/src/Feed/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- XMLReader, DOM and SimpleXML expose camelCase properties such as $nodeType and YML tags such as vendorCode. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
		<exclude-pattern>*/src/Feed/*</exclude-pattern>
	</rule>
</ruleset>
