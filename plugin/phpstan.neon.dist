includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- woo-supplier-sync.php
		- uninstall.php
		- src
	scanFiles:
		- tests/stubs/action-scheduler.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Built by npm; CI analyses the PHP without running the JS build.
		-
			identifier: require.fileNotFound
			path: src/Admin/AdminPage.php
			reportUnmatched: false
